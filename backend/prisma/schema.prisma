generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  document  String?
  phone     String?
  email     String?
  zip       String?
  street    String?
  number    String?
  complement String?
  neighborhood String?
  city      String?
  state     String?
  active    Boolean  @default(true)

  users      User[]
  units      Unit[]
  clients    Client[]
  quotes     Quote[]
  products   Product[]
  categories Category[]
  variants   ProductVariant[]
  stocks     Stock[]
  movements  StockMovement[]
  sales      Sale[]
  returns    SaleReturn[]
  exchanges  Exchange[]
  expenses   Expense[]
  apiKeys    CompanyApiKey[]
  shipments  Shipment[]
  cashRegisters CashRegister[]
  cashSessions  CashSession[]
  cashMovements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model Unit {
  id        String   @id @default(uuid())
  name      String
  type      String // store | factory
  document  String?
  phone     String?
  email     String?
  zip       String?
  street    String?
  number    String?
  complement String?
  neighborhood String?
  city      String?
  state     String?
  active    Boolean  @default(true)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  users     UserUnit[]
  stocks    Stock[]
  movements StockMovement[]
  sales     Sale[]
  returns   SaleReturn[]
  exchanges Exchange[]
  expenses  Expense[]
  shipments Shipment[]
  cashRegisters CashRegister[]
  cashSessions  CashSession[]
  cashMovements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("units")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // admin | manager | seller
  description String?
  permissions Json     @default("[]")

  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model UserUnit {
  userId String
  unitId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@map("user_units")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  companyName   String?
  phone         String?
  logo          String?
  website       String?
  active        Boolean   @default(true)
  commissionRate Decimal? @db.Decimal(5, 2)
  salary         Decimal? @db.Decimal(10, 2)

  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

  units         UserUnit[]

  planId        String?
  plan          Plan?     @relation(fields: [planId], references: [id])

  subscriptionId     String?   @unique
  subscriptionStatus String?   @default("inactive")
  subscriptionEndsAt DateTime?

  quotesThisMonth    Int       @default(0)
  quotesResetAt      DateTime  @default(now())

  clients       Client[]
  quotes        Quote[]
  payments      Payment[]
  products      Product[]
  movements     StockMovement[]
  sales         Sale[]
  cancelledSales Sale[] @relation("SaleCancelledBy")
  returns       SaleReturn[]
  exchanges     Exchange[]
  expenses      Expense[]
  apiKeys       CompanyApiKey[]
  shipments     Shipment[] @relation("ShipmentCreatedBy")
  openedCashSessions CashSession[] @relation("CashSessionOpenedBy")
  closedCashSessions CashSession[] @relation("CashSessionClosedBy")
  cashMovements CashMovement[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
  @@map("users")
}

model Plan {
  id              String    @id @default(uuid())
  name            String    @unique
  price           Decimal   @db.Decimal(10, 2)
  quotesLimit     Int
  hasWatermark    Boolean   @default(false)
  features        Json
  stripePriceId   String?   @unique

  users           User[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("plans")
}

model Client {
  id          String    @id @default(uuid())
  number      Int
  name        String
  email       String?
  phone       String?
  document    String?
  birthDate   DateTime? @db.Date
  address     String?
  city        String?
  state       String?
  zipCode     String?
  status      Int       @default(1)

  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  quotes      Quote[]
  sales       Sale[]
  shipments   Shipment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@map("clients")
}

model Quote {
  id              String      @id @default(uuid())
  idExt           String?
  title           String
  description     String?
  status          String      @default("pending")
  deletionStatus  Int         @default(1)

  items           Json
  subtotal        Decimal     @db.Decimal(10, 2)
  discount        Decimal     @db.Decimal(10, 2) @default(0)
  tax             Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)

  notes           String?
  termsConditions String?
  internalNotes   String?
  paymentTerms    String?
  additionalInfo  String?

  validUntil      DateTime?

  publicToken     String      @unique @default(uuid())
  viewCount       Int         @default(0)

  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)

  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  clientId        String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)

  sales           Sale[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([companyId])
  @@map("quotes")
}

model Payment {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripePaymentId     String?   @unique
  stripeSessionId     String?   @unique

  amount              Decimal   @db.Decimal(10, 2)
  currency            String    @default("BRL")
  status              String

  planName            String

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("payments")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  active    Boolean   @default(true)

  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products  Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("categories")
}

model Product {
  id                    String    @id @default(uuid())
  name                  String
  description           String?
  type                  String?
  gender                String?
  active                Boolean   @default(true)

  rawMaterials          Json      @default("[]")
  productionTimeHours   Decimal   @db.Decimal(10, 2) @default(0)
  energyConsumptionKwh  Decimal   @db.Decimal(10, 2) @default(0)
  energyCostPerKwh      Decimal   @db.Decimal(10, 2) @default(0)
  laborCostPerHour      Decimal   @db.Decimal(10, 2) @default(0)
  expenses              Json      @default("[]")
  profitMargin          Decimal   @db.Decimal(5, 2) @default(0)
  totalProductionCost   Decimal?  @db.Decimal(10, 2)
  minimumSalePrice      Decimal?  @db.Decimal(10, 2)
  idealSalePrice        Decimal?  @db.Decimal(10, 2)

  categoryId            String?
  category              Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  companyId             String
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  variants              ProductVariant[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  sku       String
  size      String?
  color     String?
  width     Decimal? @db.Decimal(10, 2)
  height    Decimal? @db.Decimal(10, 2)
  salePrice Decimal  @db.Decimal(10, 2)
  costPrice Decimal? @db.Decimal(10, 2)
  ncm       String?
  ean       String?
  cest      String?
  active    Boolean  @default(true)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  stocks    Stock[]
  movements StockMovement[]
  saleItems SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([productId])
  @@map("product_variants")
}

model Stock {
  id        String   @id @default(uuid())
  quantity  Decimal  @db.Decimal(12, 3) @default(0)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  updatedAt DateTime @updatedAt

  @@unique([variantId, unitId])
  @@index([companyId, unitId])
  @@map("stocks")
}

model StockMovement {
  id          String   @id @default(uuid())
  type        String
  quantity    Decimal  @db.Decimal(12, 3)
  reason      String?
  reference   String?

  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([variantId, unitId])
  @@map("stock_movements")
}

model Sale {
  id        String   @id @default(uuid())
  number    Int
  status    String   @default("completed")
  origin    String   @default("store") // store | ecommerce | quote
  channel   String   @default("retail") // retail | wholesale
  subtotal  Decimal  @db.Decimal(10, 2)
  discount  Decimal  @db.Decimal(10, 2) @default(0)
  total     Decimal  @db.Decimal(10, 2)
  notes     String?

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  cancelledBy   User?     @relation("SaleCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  quoteId   String?
  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  items     SaleItem[]
  payments  SalePayment[]
  returns   SaleReturn[]
  exchanges Exchange[]
  shipments Shipment[]
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, createdAt])
  @@index([unitId])
  @@index([clientId])
  @@index([channel])
  @@index([cashSessionId])
  @@map("sales")
}

model CompanyApiKey {
  id          String    @id @default(uuid())
  name        String
  keyHash     String    @unique
  prefix      String
  lastFour    String
  active      Boolean   @default(true)
  lastUsedAt  DateTime?

  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@map("company_api_keys")
}

model Shipment {
  id             String    @id @default(uuid())
  number         Int
  status         String    @default("pending") // pending | shipped | cancelled
  origin         String    @default("manual") // sale | ecommerce | manual
  recipientName  String
  phone          String?
  document       String?
  address        String?
  complement     String?
  neighborhood   String?
  city           String?
  state          String?
  zipCode        String?
  itemsNote      String?
  carrier        String    @default("correios") // correios | motoboy | other
  trackingCode   String?
  notes          String?
  shippedAt      DateTime?

  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  unitId         String?
  unit           Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  saleId         String?
  sale           Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdById    String
  createdBy      User      @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([saleId])
  @@index([unitId])
  @@map("shipments")
}

model SaleItem {
  id          String   @id @default(uuid())
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @db.Decimal(10, 2) @default(0)
  total       Decimal  @db.Decimal(10, 2)
  sku         String
  productName String
  size        String?
  color       String?

  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  returnItems   SaleReturnItem[]
  exchangeItems ExchangeItem[]

  @@index([saleId])
  @@map("sale_items")
}

model SalePayment {
  id        String   @id @default(uuid())
  method    String
  amount    Decimal  @db.Decimal(10, 2)

  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@map("sale_payments")
}

model SaleReturn {
  id           String   @id @default(uuid())
  number       Int
  reason       String?
  refundAmount Decimal  @db.Decimal(10, 2)
  method       String?

  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  unitId       String
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  items        SaleReturnItem[]

  createdAt    DateTime @default(now())

  @@unique([companyId, number])
  @@index([saleId])
  @@index([cashSessionId])
  @@map("returns")
}

model SaleReturnItem {
  id          String   @id @default(uuid())
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  sku         String
  productName String
  size        String?
  color       String?

  returnId    String
  saleReturn  SaleReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)

  saleItemId  String
  saleItem    SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  variantId   String?

  @@index([returnId])
  @@index([saleItemId])
  @@map("return_items")
}

model Exchange {
  id          String   @id @default(uuid())
  number      Int
  reason      String?
  difference  Decimal  @db.Decimal(10, 2)
  method      String?

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  items       ExchangeItem[]

  createdAt   DateTime @default(now())

  @@unique([companyId, number])
  @@index([saleId])
  @@index([cashSessionId])
  @@map("exchanges")
}

model ExchangeItem {
  id          String   @id @default(uuid())
  direction   String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  sku         String
  productName String
  size        String?
  color       String?

  exchangeId  String
  exchange    Exchange @relation(fields: [exchangeId], references: [id], onDelete: Restrict)

  saleItemId  String?
  saleItem    SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  variantId   String?

  @@index([exchangeId])
  @@index([saleItemId])
  @@map("exchange_items")
}

model Expense {
  id          String    @id @default(uuid())
  description String
  amount      Decimal   @db.Decimal(10, 2)
  category    String
  status      String    @default("pending")
  dueDate     DateTime? @db.Date
  paidAt      DateTime?
  notes       String?

  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  unitId      String?
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, dueDate])
  @@index([companyId, status])
  @@map("expenses")
}

model CashRegister {
  id        String   @id @default(uuid())
  name      String
  active    Boolean  @default(true)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  sessions  CashSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, name])
  @@index([companyId])
  @@index([unitId])
  @@map("cash_registers")
}

model CashSession {
  id             String    @id @default(uuid())
  status         String    @default("open") // open | closed
  openingAmount  Decimal   @db.Decimal(10, 2)
  countedCash    Decimal?  @db.Decimal(10, 2)
  expectedCash   Decimal?  @db.Decimal(10, 2)
  difference     Decimal?  @db.Decimal(10, 2)
  totals         Json?

  openedAt       DateTime  @default(now())
  closedAt       DateTime?

  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  unitId         String
  unit           Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)

  registerId     String
  register       CashRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)

  openedById     String
  openedBy       User      @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)

  closedById     String?
  closedBy       User?     @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)

  movements      CashMovement[]
  sales          Sale[]
  returns        SaleReturn[]
  exchanges      Exchange[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, status])
  @@index([unitId, status])
  @@index([registerId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id             String   @id @default(uuid())
  type           String   // open | supply | bleed | refund | close
  amount         Decimal  @db.Decimal(10, 2)
  reason         String?
  referenceType  String?  // sale | return | exchange
  referenceId    String?

  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  unitId         String
  unit           Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  sessionId      String
  session        CashSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt      DateTime @default(now())

  @@index([sessionId, type])
  @@index([companyId])
  @@index([referenceType, referenceId])
  @@map("cash_movements")
}
